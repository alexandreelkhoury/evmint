# ============================================================================
# EVMint - ENVIRONMENT VARIABLES
# Multi-Chain EVM Token Deployment Platform
# ============================================================================

# ----------------------------------------------------------------------------
# PRIVY AUTHENTICATION (REQUIRED)
# ----------------------------------------------------------------------------
VITE_PRIVY_APP_ID=your_privy_app_id_here

# ----------------------------------------------------------------------------
# DEVELOPMENT / TESTING MODE
# ----------------------------------------------------------------------------
# Set to 'true' to deploy tokens without fees (for testing only!)
VITE_FREE_MODE=false

# ----------------------------------------------------------------------------
# FIREBASE ANALYTICS (Optional)
# ----------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abc123def456
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ----------------------------------------------------------------------------
# BLOCK EXPLORER API KEY (For Contract Verification)
# Etherscan V2 unified API - ONE key works for ALL chains!
# Get your key at: https://etherscan.io/myapikey
# ----------------------------------------------------------------------------
VITE_ETHERSCAN_API_KEY=your_etherscan_api_key

# ----------------------------------------------------------------------------
# CUSTOM RPC ENDPOINTS (Optional - Improves Performance)
# ----------------------------------------------------------------------------
VITE_ETHEREUM_MAINNET_RPC=https://eth.llamarpc.com
VITE_BASE_MAINNET_RPC=https://mainnet.base.org
VITE_ARBITRUM_MAINNET_RPC=https://arb1.arbitrum.io/rpc
VITE_POLYGON_MAINNET_RPC=https://polygon-rpc.com
